/* =========================================================
   MABIJUFIT — STYLE.CSS CONSOLIDADO
   Versão mobile-first
   ========================================================= */


/* =========================================================
   1. VARIÁVEIS
   ========================================================= */

:root {
    --pink-50: #fff8fb;
    --pink-100: #fce8ef;
    --pink-200: #f7d3df;
    --pink-300: #eeb8ca;
    --pink-400: #df91aa;
    --pink-500: #c96f8c;
    --pink-600: #b95776;
    --pink-700: #98425f;

    --rose-gold: #b77b86;
    --rose-gold-light: #d7a4ad;
    --rose-gold-dark: #8f5b65;

    --white: #ffffff;
    --black: #222222;

    --gray-50: #fafafa;
    --gray-100: #f4f4f5;
    --gray-200: #e5e5e7;
    --gray-300: #d4d4d8;
    --gray-400: #a1a1aa;
    --gray-500: #71717a;
    --gray-600: #52525b;
    --gray-700: #3f3f46;
    --gray-800: #27272a;
    --gray-900: #18181b;

    --success: #27754b;
    --success-light: #edf8f1;

    --warning: #8a5a23;
    --warning-light: #fff7e9;

    --danger: #ad3651;
    --danger-light: #fff0f3;

    --info: #658ca8;
    --info-light: #eef6fb;

    --background: #fffafc;
    --surface: #ffffff;
    --border: #f0dce3;

    --text: #2d2528;
    --text-muted: #7b6d72;

    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;
    --radius-xl: 20px;
    --radius-pill: 999px;

    --shadow-sm: 0 2px 8px rgba(113, 67, 81, 0.06);
    --shadow-md: 0 5px 18px rgba(113, 67, 81, 0.09);
    --shadow-lg: 0 10px 30px rgba(113, 67, 81, 0.13);

    --bottom-nav-height: 74px;
    --header-height: 64px;

    --content-max-width: 1200px;
}


/* =========================================================
   2. RESET
   ========================================================= */

*,
*::before,
*::after {
    box-sizing: border-box;
}

html {
    min-height: 100%;
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
}

body {
    min-height: 100%;
    margin: 0;

    background: var(--background);
    color: var(--text);

    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif;

    font-size: 16px;
    line-height: 1.5;

    overflow-x: hidden;

    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;

    padding-bottom: 0;
}

body.modal-open {
    overflow: hidden;
    overscroll-behavior: none;
}

button,
input,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

img {
    display: block;
    max-width: 100%;
}

svg {
    display: block;
}

a {
    color: inherit;
}

[hidden],
.hidden {
    display: none !important;
}


/* =========================================================
   3. APP
   ========================================================= */

#app {
    position: relative;

    width: 100%;

    min-height: 100vh;
    min-height: 100dvh;

    overflow: visible;

    transform: none !important;
    filter: none !important;
    perspective: none !important;
}


/* =========================================================
   4. LOGIN
   ========================================================= */

.login-page {
    min-height: 100vh;
    min-height: 100dvh;

    display: flex;
    align-items: center;
    justify-content: center;

    padding:
        24px 18px
        calc(24px + env(safe-area-inset-bottom));

    background:
        linear-gradient(
            180deg,
            #fffafd 0%,
            #ffffff 100%
        );
}

.login-container,
.login-card {
    width: 100%;
    max-width: 440px;
}

.login-container {
    margin: auto;
}

.login-card {
    text-align: center;
}

.login-card img,
.login-logo {
    width: 140px;
    height: 140px;

    margin: 0 auto 28px;

    object-fit: contain;
}

.login-card h1,
.login-title {
    margin: 0 0 8px;

    color: var(--gray-900);

    font-size: 38px;
    font-weight: 800;
    letter-spacing: -1.5px;
}

.login-card p,
.login-subtitle {
    margin: 0 0 28px;

    color: var(--text);

    font-size: 19px;
}

.login-card form {
    text-align: left;
}


/* =========================================================
   5. CABEÇALHO SUPERIOR
   ========================================================= */

/*
   Cabeçalho compacto e discreto.
   Evita o aspecto de "página web simples".
*/

.app-header,
.top-header {
    position: relative;

    z-index: 100;

    width: 100%;
    min-height: var(--header-height);

    display: flex;
    align-items: center;

    background:
        rgba(255, 255, 255, 0.98);

    border-bottom: 1px solid var(--border);

    box-shadow:
        0 2px 12px rgba(113, 67, 81, 0.045);

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
}

.app-header-inner {
    width: 100%;
    max-width: var(--content-max-width);

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 16px;
    margin: 0 auto;

    padding:
        8px
        max(16px, env(safe-area-inset-right))
        8px
        max(16px, env(safe-area-inset-left));
}

/*
   Qualquer conteúdo textual do header fica compacto.
*/

.app-header p,
.app-header .user-info,
.app-header .header-user,
.app-header .user-email,
.app-header .app-greeting {
    margin: 0;

    color: var(--text-muted);

    font-size: 13px;
    line-height: 1.25;

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.app-header strong,
.app-header b {
    color: var(--text);
    font-weight: 700;
}

/*
   Botão Sair — deixa de parecer botão padrão do navegador.
*/

.app-header button,
.app-header .logout-button,
.app-header button[type="button"] {
    min-width: 64px;
    min-height: 36px;

    padding: 6px 13px;

    border: 1px solid var(--border);
    border-radius: var(--radius-pill);

    background: var(--white);
    color: var(--rose-gold-dark);

    font-size: 13px;
    font-weight: 700;

    box-shadow: none;

    transition:
        background 0.18s ease,
        border-color 0.18s ease,
        transform 0.18s ease;
}

.app-header button:hover,
.app-header .logout-button:hover {
    background: var(--pink-50);
    border-color: var(--pink-300);
}

.app-header button:active,
.app-header .logout-button:active {
    transform: scale(0.97);
}


/* =========================================================
   6. CONTEÚDO
   ========================================================= */

.app-content {
    width: 100%;
    max-width: var(--content-max-width);

    margin: 0 auto;

    padding:
        22px 16px
        calc(
            var(--bottom-nav-height) +
            env(safe-area-inset-bottom) +
            24px
        );
}


/* =========================================================
   7. TÍTULOS
   ========================================================= */

section > h1,
.page-title,
h1 {
    margin: 0 0 24px;

    color: var(--gray-900);

    font-size: 32px;
    line-height: 1.15;
    font-weight: 800;

    letter-spacing: -0.8px;
}

section > h2,
h2 {
    margin: 26px 0 16px;

    color: var(--gray-900);

    font-size: 24px;
    line-height: 1.2;
    font-weight: 750;
}

section > h3,
h3 {
    margin: 18px 0 12px;

    color: var(--gray-800);

    font-size: 19px;
    line-height: 1.25;
    font-weight: 700;
}


/* =========================================================
   8. BOTÕES
   ========================================================= */

button,
.button {
    min-height: 44px;

    border-radius: var(--radius-md);

    transition:
        background 0.18s ease,
        border-color 0.18s ease,
        color 0.18s ease,
        box-shadow 0.18s ease,
        transform 0.18s ease;

    -webkit-tap-highlight-color: transparent;
}

button:active,
.button:active {
    transform: translateY(1px);
}

.primary-button,
button.primary-button,
.button.primary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;

    min-height: 48px;

    padding: 10px 20px;

    border: 1px solid var(--pink-500);

    background: var(--pink-700);
    color: var(--white);

    font-weight: 700;

    box-shadow:
        0 5px 14px rgba(201, 111, 140, 0.18);
}

.primary-button:hover,
button.primary-button:hover {
    background: var(--pink-700);
    border-color: var(--pink-700);
}

.secondary-button,
button.secondary-button,
.button.secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    min-height: 46px;

    padding: 9px 18px;

    border: 1px solid var(--border);

    background: var(--white);
    color: var(--gray-700);

    font-weight: 700;
}

.secondary-button:hover,
button.secondary-button:hover {
    background: var(--pink-50);
    border-color: var(--pink-300);
}

.icon-button,
.action-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 42px;
    height: 42px;

    min-width: 42px;
    min-height: 42px;

    padding: 0;

    border: 1px solid var(--border);
    border-radius: 12px;

    background: var(--white);
    color: var(--gray-700);
}

.icon-button:hover,
.action-icon:hover {
    background: var(--pink-50);
    border-color: var(--pink-300);
}

button:disabled,
.button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
}


/* =========================================================
   9. FORMULÁRIOS
   ========================================================= */

.form-group {
    display: flex;
    flex-direction: column;
    gap: 7px;

    margin-bottom: 16px;
}

.form-grid {
    display: grid;
    grid-template-columns: 1fr;

    gap: 16px;
}

label {
    display: block;

    color: var(--gray-700);

    font-size: 15px;
    line-height: 1.25;
    font-weight: 700;
}

input,
select,
textarea {
    width: 100%;

    min-height: 48px;

    padding: 11px 14px;

    border: 1px solid var(--border);
    border-radius: var(--radius-md);

    background: var(--white);
    color: var(--gray-800);

    font-size: 16px;

    outline: none;

    transition:
        border-color 0.18s ease,
        box-shadow 0.18s ease;
}

textarea {
    min-height: 120px;
    resize: vertical;
}

input::placeholder,
textarea::placeholder {
    color: var(--gray-400);
}

input:focus,
select:focus,
textarea:focus {
    border-color: var(--pink-400);

    box-shadow:
        0 0 0 3px rgba(223, 145, 170, 0.14);
}

input[type="checkbox"],
input[type="radio"] {
    width: 18px;
    height: 18px;

    min-width: 18px;
    min-height: 18px;

    padding: 0;

    accent-color: var(--pink-500);
}

input[type="file"] {
    min-height: 48px;
    padding: 8px;
}


/* =========================================================
   10. MENSAGENS
   ========================================================= */

.form-message {
    margin: 10px 0;
    padding: 11px 13px;

    border-radius: var(--radius-md);

    font-size: 14px;
}

.form-message:empty {
    display: none;
}

.form-message.success {
    background: var(--success-light);
    color: #477b5b;

    border: 1px solid #d5ebdc;
}

.form-message.error {
    background: var(--danger-light);
    color: #9d4658;

    border: 1px solid #f2d0d8;
}


/* =========================================================
   11. CARDS DE RESUMO
   ========================================================= */

.dashboard-grid,
.summary-grid,
.stats-grid,
.metrics-grid {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 14px;

    margin-bottom: 22px;
}

.dashboard-card,
.summary-card,
.stat-card,
.metric-card,
.finance-card,
.sale-card {
    min-width: 0;

    padding: 18px;

    background: var(--white);

    border: 1px solid var(--border);
    border-radius: var(--radius-lg);

    box-shadow: var(--shadow-sm);
}


/* =========================================================
   12. ACESSOS RÁPIDOS
   ========================================================= */

/*
   Os acessos rápidos devem parecer atalhos do aplicativo,
   não botões padrão do navegador.
*/

.quick-actions,
.quick-access,
.quick-access-grid,
.dashboard-quick-actions {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 10px;

    width: 100%;

    margin-bottom: 22px;
}

.quick-actions button,
.quick-access button,
.quick-access-grid button,
.dashboard-quick-actions button,
.quick-actions a,
.quick-access a,
.quick-access-grid a,
.dashboard-quick-actions a {
    position: relative;

    min-width: 0;
    min-height: 56px;

    display: flex;
    align-items: center;
    justify-content: center;

    gap: 8px;

    padding: 10px 12px;

    border: 1px solid var(--border);
    border-radius: 15px;

    background: var(--white);
    color: var(--gray-700);

    font-size: 15px;
    font-weight: 700;

    box-shadow: var(--shadow-sm);

    text-decoration: none;

    overflow: hidden;
}

.quick-actions button:hover,
.quick-access button:hover,
.quick-access-grid button:hover,
.dashboard-quick-actions button:hover,
.quick-actions a:hover,
.quick-access a:hover,
.quick-access-grid a:hover,
.dashboard-quick-actions a:hover {
    background: var(--pink-50);
    border-color: var(--pink-300);
}

.quick-actions svg,
.quick-access svg,
.quick-access-grid svg,
.dashboard-quick-actions svg {
    display: block !important;

    width: 22px !important;
    height: 22px !important;

    flex: 0 0 auto;

    color: var(--pink-600);

    stroke: currentColor;
}

/*
   Caso existam spans destinados aos ícones.
*/

.quick-actions .icon,
.quick-actions .quick-icon,
.quick-access .icon,
.quick-access .quick-icon,
.quick-access-grid .icon,
.quick-access-grid .quick-icon,
.dashboard-quick-actions .icon,
.dashboard-quick-actions .quick-icon {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    width: 24px;
    height: 24px;

    flex: 0 0 auto;

    color: var(--pink-600);
}

.quick-actions .icon svg,
.quick-actions .quick-icon svg,
.quick-access .icon svg,
.quick-access .quick-icon svg,
.quick-access-grid .icon svg,
.quick-access-grid .quick-icon svg,
.dashboard-quick-actions .icon svg,
.dashboard-quick-actions .quick-icon svg {
    width: 22px !important;
    height: 22px !important;
}

/*
   Evita que o primeiro caractere usado como fallback
   domine visualmente o botão quando houver um SVG presente.
*/

.quick-actions svg + span,
.quick-access svg + span,
.quick-access-grid svg + span,
.dashboard-quick-actions svg + span {
    min-width: 0;
}


/* =========================================================
   13. ESTADOS VAZIOS
   ========================================================= */

.empty-state {
    width: 100%;

    min-height: 210px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    padding: 28px 20px;

    text-align: center;

    background: var(--white);

    border: 1px dashed var(--border);
    border-radius: var(--radius-xl);
}

.empty-state.compact {
    min-height: 150px;
    padding: 22px 16px;
}

.empty-state-icon {
    width: 58px;
    height: 58px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 14px;

    border-radius: 50%;

    background: var(--pink-100);
    color: var(--pink-600);

    font-size: 22px;
    font-weight: 800;
}

.empty-state h3,
.empty-state strong {
    margin: 0 0 6px;

    color: var(--gray-800);

    font-size: 18px;
}

.empty-state p {
    margin: 0;

    color: var(--text-muted);

    font-size: 15px;
}


/* =========================================================
   14. BUSCA
   ========================================================= */

.search-container,
.search-wrapper,
.list-search {
    width: 100%;

    margin-bottom: 14px;
}

.search-container input,
.search-wrapper input,
.list-search input {
    min-height: 50px;

    border-radius: 16px;

    font-size: 17px;
}


/* =========================================================
   15. PRODUTOS — NOVO LAYOUT HORIZONTAL
   ========================================================= */

/*
   Antes:

   ┌───────────────┐
   │     FOTO      │
   │     GRANDE    │
   ├───────────────┤
   │ informações   │
   └───────────────┘

   Agora:

   ┌───────┬────────────────────┐
   │       │ Nome               │
   │ FOTO  │ SKU                │
   │       │ Categoria          │
   │       │ Cores / tamanhos   │
   │       │ Estoque            │
   │       │ Preço              │
   │       │ Ações              │
   └───────┴────────────────────┘
*/

.product-grid,
.products-grid {
    display: grid;

    grid-template-columns: 1fr;

    gap: 12px;

    width: 100%;
}

.product-card {
    width: 100%;
    min-width: 0;

    display: grid;

    grid-template-columns: 112px minmax(0, 1fr);

    overflow: hidden;

    background: var(--white);

    border: 1px solid var(--border);
    border-radius: var(--radius-xl);

    box-shadow: var(--shadow-sm);

    transition:
        transform 0.18s ease,
        box-shadow 0.18s ease;
}

.product-card:active {
    transform: translateY(1px);
}


/* =========================================================
   16. FOTO DO PRODUTO
   ========================================================= */

.product-card-image-wrapper {
    position: relative;

    width: 112px;
    min-width: 112px;

    height: 100%;
    min-height: 220px;

    overflow: hidden;

    background: var(--gray-100);
}

.product-card-image {
    width: 100%;
    height: 100%;

    object-fit: cover;

    background: var(--gray-100);
}

/*
   Fotos verticais de roupas podem ser preservadas sem
   distorção. Se o enquadramento for muito vertical,
   contain evita cortar a peça.
*/

.product-card-image.portrait,
.product-card-image.vertical {
    object-fit: contain;

    background: var(--gray-100);
}

.product-image-placeholder {
    width: 100%;
    height: 100%;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 10px;

    background: var(--pink-50);
    color: var(--pink-400);

    font-size: 12px;
    text-align: center;
}


/* =========================================================
   17. INFORMAÇÕES DO PRODUTO
   ========================================================= */

.product-card-info {
    min-width: 0;

    display: flex;
    flex-direction: column;

    padding: 13px 13px 12px;
}

.product-card-name {
    margin: 0 0 4px;

    color: var(--gray-900);

    font-size: 18px;
    line-height: 1.2;
    font-weight: 800;

    overflow-wrap: anywhere;
}

.product-card-sku,
.product-card-category {
    color: var(--text-muted);

    font-size: 13px;

    overflow-wrap: anywhere;
}

.product-card-details {
    display: flex;
    flex-direction: column;
    gap: 4px;

    margin-top: 9px;

    color: var(--gray-700);

    font-size: 13px;
}

.product-card-stock {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 6px;

    margin-top: 10px;

    color: var(--gray-700);

    font-size: 13px;
}

.product-card-price {
    margin-top: auto;
    padding-top: 10px;

    color: var(--pink-600);

    font-size: 20px;
    line-height: 1.1;
    font-weight: 800;
}

.product-card-actions {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 7px;

    margin-top: 10px;
}

.product-card-actions button {
    width: 100%;
    min-width: 0;

    min-height: 42px;

    padding:
        7px 6px;

    border: 1px solid var(--border);

    background: var(--white);
    color: var(--gray-700);

    font-size: 14px;
    font-weight: 700;
}

.product-card-sell-button {
    color: var(--pink-600) !important;

    border-color:
        var(--pink-200) !important;
}

.product-card-edit-button {
    color: var(--gray-700) !important;
}


/* =========================================================
   18. STATUS DO ESTOQUE
   ========================================================= */

.product-stock-status {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 30px;

    padding: 5px 9px;

    border-radius: var(--radius-pill);

    font-size: 12px;
    line-height: 1;

    font-weight: 700;

    white-space: nowrap;
}

.product-stock-status.normal {
    background: var(--success-light);
    color: var(--success);
}

.product-stock-status.low {
    background: var(--warning-light);
    color: var(--warning);
}

.product-stock-status.zero {
    background: var(--danger-light);
    color: var(--danger);
}


/* =========================================================
   19. THUMBNAILS / FOTOS
   ========================================================= */

.product-thumbnail {
    width: 72px;
    height: 72px;

    object-fit: cover;

    border-radius: 14px;

    background: var(--gray-100);
}

.product-existing-photos {
    margin-top: 12px;
}

.product-existing-photos-title {
    margin-bottom: 8px;

    font-size: 14px;
    font-weight: 700;
}

.product-existing-photos-grid,
.product-photo-preview {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 8px;
}

.product-existing-photo,
.product-photo-preview-item {
    overflow: hidden;

    border: 1px solid var(--border);
    border-radius: var(--radius-md);

    background: var(--gray-50);
}

.product-existing-photo img,
.product-photo-preview-item img {
    width: 100%;

    aspect-ratio: 3 / 4;

    object-fit: contain;
}

.product-photo-preview-info {
    padding: 7px;

    font-size: 12px;
}

.product-photo-preview-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}


/* =========================================================
   20. VARIAÇÕES
   ========================================================= */

.product-variant-draft-item {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 10px;

    padding: 12px;

    border: 1px solid var(--border);
    border-radius: var(--radius-md);

    background: var(--white);
}

.product-variant-draft-info {
    min-width: 0;
}

.product-variant-draft-size {
    color: var(--text-muted);

    font-size: 13px;
}

.product-variant-draft-actions {
    display: flex;
    align-items: center;
    gap: 6px;
}

.product-variant-quantity-control {
    display: inline-flex;
    align-items: center;

    gap: 5px;
}

.variation-section {
    margin-top: 18px;

    padding: 15px;

    border: 1px solid var(--border);
    border-radius: var(--radius-lg);

    background: var(--pink-50);
}

.variation-heading {
    margin: 0 0 12px;

    font-size: 16px;
    font-weight: 800;
}

.product-variation-form {
    display: grid;

    grid-template-columns: 1fr;

    gap: 10px;
}

.product-variation-field {
    min-width: 0;
}

.product-variation-batch {
    display: flex;
    flex-wrap: wrap;

    gap: 8px;
}


/* =========================================================
   21. ESTOQUE
   ========================================================= */

.stock-grid,
.stock-list {
    display: flex;
    flex-direction: column;

    gap: 12px;
}

.stock-card {
    display: grid;

    grid-template-columns:
        64px
        minmax(0, 1fr)
        auto;

    align-items: center;

    gap: 11px;

    padding: 11px 13px;

    background: var(--white);

    border: 1px solid var(--border);
    border-radius: var(--radius-lg);

    box-shadow: var(--shadow-sm);
}

.stock-card-image-wrapper {
    width: 64px;
    height: 64px;

    overflow: hidden;

    border-radius: 14px;

    background: var(--gray-100);
}

.stock-card-image {
    width: 100%;
    height: 100%;

    object-fit: cover;
}

.stock-card-info {
    min-width: 0;
}

.stock-card-info strong {
    display: block;

    margin-bottom: 2px;

    font-size: 17px;

    overflow-wrap: anywhere;
}

.stock-card-info span {
    display: block;

    color: var(--text-muted);

    font-size: 13px;
}

.stock-card-quantity {
    min-width: 66px;

    padding: 9px 7px;

    text-align: center;

    border-radius: 14px;

    background: var(--success-light);
    color: var(--success);

    font-weight: 800;
}

.stock-card-quantity.low {
    background: var(--warning-light);
    color: var(--warning);
}

.stock-card-quantity.zero {
    background: var(--danger-light);
    color: var(--danger);
}


/* =========================================================
   22. VENDAS
   ========================================================= */

.sale-management {
    display: flex;
    flex-direction: column;

    min-width: 0;
    min-height: 0;

    gap: 16px;
}

.sale-management-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 12px;
}

.sale-management-header h2,
.sale-management-header h3 {
    margin: 0;
}

.sale-management-actions {
    display: flex;
    flex-wrap: wrap;

    gap: 8px;
}

.sale-management-footer {
    display: flex;

    gap: 10px;

    padding-top: 14px;

    border-top: 1px solid var(--border);
}

.sale-management-footer > * {
    flex: 1 1 0;
    min-width: 0;
}

.sale-product-picker {
    padding: 16px;

    border: 1px solid var(--pink-100);
    border-radius: var(--radius-xl);

    background: var(--pink-50);
}

.sale-product-picker-item {
    display: grid;

    grid-template-columns:
        58px
        minmax(0, 1fr)
        auto;

    align-items: center;

    gap: 10px;

    width: 100%;

    padding: 10px;

    border: 1px solid var(--border);
    border-radius: var(--radius-lg);

    background: var(--white);

    text-align: left;
}

.sale-product-picker-item + .sale-product-picker-item {
    margin-top: 10px;
}

.sale-product-picker-image {
    width: 58px;
    height: 58px;

    object-fit: cover;

    border-radius: 12px;

    background: var(--gray-100);
}

.sale-product-picker-item strong {
    display: block;

    font-size: 16px;
}

.sale-product-picker-item span {
    display: block;

    color: var(--text-muted);

    font-size: 13px;
}

.sale-variant-picker-item {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 10px;

    padding: 11px;

    border: 1px solid var(--border);
    border-radius: var(--radius-md);

    background: var(--white);
}

.sale-draft-item {
    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        auto;

    gap: 10px;

    padding: 14px;

    border: 1px solid var(--border);
    border-radius: var(--radius-lg);

    background: var(--white);
}

.sale-summary {
    padding: 16px;

    border: 1px solid var(--pink-100);
    border-radius: var(--radius-xl);

    background: #fff8fa;
}

.sale-summary > div {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 12px;

    padding: 7px 0;
}

.sale-summary input {
    width: min(140px, 48%);
}

.sale-summary .total {
    margin-top: 6px;

    padding-top: 12px;

    border-top: 1px solid var(--border);

    color: var(--pink-600);

    font-size: 20px;
    font-weight: 800;
}


/* =========================================================
   23. FINANCEIRO
   ========================================================= */

.income {
    color: var(--success);
}

.expense {
    color: var(--danger);
}


/* =========================================================
   24. CATEGORIAS
   ========================================================= */

.category-grid,
.categories-grid {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 12px;
}

.category-card {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 10px;

    padding: 14px;

    background: var(--white);

    border: 1px solid var(--border);
    border-radius: var(--radius-lg);

    box-shadow: var(--shadow-sm);
}

.category-card-info {
    min-width: 0;
}

.category-card-info strong,
.category-card-info span {
    display: block;
}

.category-card-info span {
    color: var(--text-muted);
    font-size: 13px;
}

.category-card-actions {
    display: flex;
    gap: 6px;
}


/* =========================================================
   25. CORES
   ========================================================= */

.color-grid,
.colors-grid {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 12px;
}

.color-card {
    display: flex;
    align-items: center;

    gap: 12px;

    padding: 14px;

    background: var(--white);

    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
}

.color-card-info {
    display: flex;
    align-items: center;

    gap: 10px;

    min-width: 0;
}

.color-card-swatch {
    flex: 0 0 auto;

    width: 34px;
    height: 34px;

    border-radius: 50%;

    border: 2px solid var(--white);

    box-shadow:
        0 0 0 1px var(--border);
}

.color-card-text {
    min-width: 0;
}

.color-card-name,
.color-card-code {
    display: block;

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.color-card-name {
    font-weight: 700;
}

.color-card-code {
    color: var(--text-muted);

    font-size: 12px;
}

.color-card-actions {
    margin-left: auto;

    display: flex;
    gap: 6px;
}


/* =========================================================
   26. TAMANHOS
   ========================================================= */

.size-grid,
.sizes-grid {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 12px;
}

.size-card {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 10px;

    padding: 14px;

    background: var(--white);

    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
}

.size-card-info {
    display: flex;
    align-items: center;

    gap: 10px;
}

.size-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-width: 40px;
    height: 40px;

    padding: 5px 9px;

    border-radius: 12px;

    background: var(--pink-100);
    color: var(--pink-600);

    font-weight: 800;
}

.size-card-name {
    font-weight: 700;
}

.size-card-order {
    color: var(--text-muted);

    font-size: 12px;
}

.size-card-actions {
    display: flex;
    gap: 6px;
}


/* =========================================================
   27. MENU INFERIOR
   ========================================================= */

.bottom-navigation {
    position: fixed !important;

    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;

    z-index: 900 !important;

    width: 100% !important;
    height: calc(var(--bottom-nav-height) + env(safe-area-inset-bottom)) !important;

    display: flex !important;
    flex-direction: row !important;
    align-items: stretch !important;
    justify-content: space-around !important;

    margin: 0 !important;

    padding:
        6px
        max(6px, env(safe-area-inset-right))
        max(6px, env(safe-area-inset-bottom))
        max(6px, env(safe-area-inset-left)) !important;

    background:
        rgba(255, 255, 255, 0.98) !important;

    border-top:
        1px solid var(--border) !important;

    border-left: 0 !important;
    border-right: 0 !important;
    border-bottom: 0 !important;

    box-shadow:
        0 -4px 18px rgba(113, 67, 81, 0.08) !important;

    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);

    overflow: hidden !important;
}

.bottom-navigation .nav-item {
    flex: 1 1 0 !important;

    min-width: 0 !important;
    min-height: 0 !important;

    height: 100% !important;

    display: flex !important;
    flex-direction: column !important;

    align-items: center !important;
    justify-content: center !important;

    gap: 3px !important;

    margin: 0 !important;

    padding: 5px 3px !important;

    border: 0 !important;
    border-radius: 14px !important;

    background: transparent !important;

    color: var(--text-muted) !important;

    font-size: 10px !important;
    line-height: 1.1 !important;
    font-weight: 600 !important;

    text-align: center !important;

    white-space: nowrap !important;

    overflow: hidden !important;
}

.bottom-navigation .nav-item:hover {
    background: var(--pink-50) !important;
}

.bottom-navigation .nav-item.active {
    color: var(--pink-600) !important;

    background: var(--pink-100) !important;
}

.bottom-navigation .nav-icon {
    display: block !important;

    width: 22px !important;
    height: 22px !important;

    min-width: 22px !important;
    min-height: 22px !important;

    flex: 0 0 auto !important;

    color: currentColor !important;

    stroke: currentColor;
}

.bottom-navigation .nav-item span,
.bottom-navigation .nav-item small {
    display: block;

    max-width: 100%;

    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;
}

.bottom-navigation .nav-item.active span,
.bottom-navigation .nav-item.active small {
    font-weight: 700;
}


/* =========================================================
   28. MODAIS
   ========================================================= */

.modal {
    position: fixed !important;

    inset: 0 !important;

    z-index: 1000 !important;

    width: 100% !important;
    height: 100% !important;

    min-height: 100dvh !important;

    margin: 0 !important;

    padding:
        max(12px, env(safe-area-inset-top))
        max(12px, env(safe-area-inset-right))
        max(12px, env(safe-area-inset-bottom))
        max(12px, env(safe-area-inset-left));

    display: flex !important;

    align-items: center !important;
    justify-content: center !important;

    background:
        rgba(43, 29, 34, 0.48) !important;

    overflow-x: hidden !important;
    overflow-y: auto !important;

    overscroll-behavior: contain;

    -webkit-overflow-scrolling: touch;

    animation:
        modalOverlayIn 0.18s ease-out;
}

.modal[hidden],
.modal.hidden {
    display: none !important;
}

.modal-content {
    position: relative;

    width: 100% !important;

    max-width: 680px !important;

    max-height:
        calc(
            100dvh
            -
            env(safe-area-inset-top)
            -
            env(safe-area-inset-bottom)
            -
            24px
        ) !important;

    min-height: 0;

    margin: auto !important;

    display: flex;

    flex-direction: column;

    overflow: hidden;

    background: var(--white);

    border: 1px solid var(--border);

    border-radius: var(--radius-xl);

    box-shadow: var(--shadow-lg);

    overscroll-behavior: contain;

    animation:
        modalContentIn 0.18s ease-out;
}

.modal-header {
    flex: 0 0 auto;

    display: flex;

    align-items: flex-start;
    justify-content: space-between;

    gap: 12px;

    padding: 18px 18px 14px;

    border-bottom: 1px solid var(--border);

    background: var(--white);
}

.modal-header h1,
.modal-header h2,
.modal-header h3 {
    margin: 0;

    color: var(--gray-900);

    font-size: 21px;
    line-height: 1.2;
    font-weight: 800;
}

.modal-header p {
    margin: 3px 0 0;

    color: var(--text-muted);

    font-size: 13px;
}

.modal-header button,
.modal-header .icon-button {
    flex: 0 0 auto;

    width: 40px;
    height: 40px;

    min-width: 40px;
    min-height: 40px;

    padding: 0;

    border: 1px solid var(--gray-300);
    border-radius: 8px;

    background: var(--gray-100);
    color: var(--gray-800);

    font-size: 20px;
}

.modal-close {
    line-height: 1;
}

.modal-body {
    flex: 1 1 auto;

    min-width: 0;
    min-height: 0;

    padding: 18px;

    overflow-x: hidden;
    overflow-y: auto;

    -webkit-overflow-scrolling: touch;

    overscroll-behavior: contain;
}

.modal-content > form {
    flex: 1 1 auto;

    min-width: 0;
    min-height: 0;

    display: flex;
    flex-direction: column;

    overflow-x: hidden;
    overflow-y: auto;

    -webkit-overflow-scrolling: touch;

    overscroll-behavior: contain;

    padding: 18px;
}

.modal-actions {
    flex: 0 0 auto;

    display: flex;

    align-items: center;

    gap: 10px;

    margin-top: 6px;

    padding-top: 16px;

    border-top: 1px solid var(--border);

    background: var(--white);
}

.modal-actions button {
    flex: 1 1 0;

    min-width: 0;
}


/* =========================================================
   29. MODAL DE VENDA
   ========================================================= */

#saleModal .modal-content {
    max-width: 700px !important;

    min-height: 0;
}

#saleModal #saleManagementWorkspace {
    flex: 1 1 auto;

    min-width: 0;
    min-height: 0;

    overflow-x: hidden;
    overflow-y: auto;

    -webkit-overflow-scrolling: touch;

    overscroll-behavior: contain;
}

#saleModal .sale-management {
    min-height: 0;

    padding: 0;
}

#saleModal .sale-management-footer {
    flex-shrink: 0;
}


/* =========================================================
   30. TABELAS
   ========================================================= */

.table-wrapper {
    width: 100%;

    overflow-x: auto;

    border: 1px solid var(--border);
    border-radius: var(--radius-lg);

    background: var(--white);
}

table {
    width: 100%;

    border-collapse: collapse;

    font-size: 14px;
}

th,
td {
    padding: 12px;

    text-align: left;

    border-bottom: 1px solid var(--border);
}

th {
    color: var(--gray-700);

    font-weight: 700;

    background: var(--pink-50);
}

tr:last-child td {
    border-bottom: 0;
}


/* =========================================================
   31. ATIVIDADE RECENTE
   ========================================================= */

.recent-activity,
.activity-list {
    width: 100%;
}

.activity-item {
    display: flex;

    align-items: flex-start;

    gap: 12px;

    padding: 12px 0;

    border-bottom: 1px solid var(--border);
}

.activity-item:last-child {
    border-bottom: 0;
}

.activity-icon {
    flex: 0 0 auto;

    width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: var(--pink-100);
    color: var(--pink-600);

    font-weight: 800;
}


/* =========================================================
   32. ANIMAÇÕES
   ========================================================= */

@keyframes modalOverlayIn {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

@keyframes modalContentIn {
    from {
        opacity: 0;

        transform:
            translateY(8px)
            scale(0.985);
    }

    to {
        opacity: 1;

        transform:
            translateY(0)
            scale(1);
    }
}


/* =========================================================
   33. ACESSIBILIDADE
   ========================================================= */

button:focus-visible,
a:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
    outline:
        3px solid var(--pink-700);

    outline-offset: 2px;
}


/* =========================================================
   34. MOBILE
   ========================================================= */

/* =========================================================
   ESTRUTURA E COMPONENTES DA INTERFACE ATUAL
   ========================================================= */

.app-screen {
    width: 100%;
    min-height: 100vh;
    min-height: 100dvh;
}

.header-profile {
    min-width: 0;

    display: flex;
    align-items: center;
    gap: 11px;
}

.header-avatar {
    flex: 0 0 auto;

    width: 38px;
    height: 38px;

    display: grid;
    place-items: center;

    border-radius: 50%;

    background: linear-gradient(145deg, var(--pink-100), var(--pink-200));
    color: var(--pink-700);

    font-weight: 800;
}

.header-user-copy {
    min-width: 0;

    display: flex;
    flex-direction: column;
}

.header-user-copy #userName {
    display: block;
    max-width: min(62vw, 520px);

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.app-section {
    width: 100%;
}

.section-heading,
.subsection-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;

    gap: 16px;
}

.section-heading {
    margin-bottom: 20px;
}

.subsection-heading {
    align-items: center;
    margin-bottom: 14px;
}

.section-heading h2,
.subsection-heading h3,
.section-block > h3 {
    margin: 3px 0 0;
}

.section-heading p {
    margin: 6px 0 0;
    color: var(--text-muted);
    font-size: 14px;
}

.section-eyebrow {
    display: block;

    color: var(--pink-600);

    font-size: 11px;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: 0.1em;
}

.section-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 8px;
}

.section-block {
    margin-top: 30px;
    padding-top: 24px;

    border-top: 1px solid var(--border);
}

.cards-list {
    width: 100%;
}

.cards-list > .empty-state {
    grid-column: 1 / -1;
}

.search-input {
    margin-bottom: 16px;
    border-radius: 16px;
}

.form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
}

.checkbox-label {
    display: inline-flex;
    align-items: center;
    gap: 9px;

    margin-bottom: 16px;
}

.primary-button.small,
.secondary-button.small {
    min-height: 42px;
    padding: 8px 14px;
    font-size: 14px;
}

.sr-only {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
}

.metric-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.metric-card > span {
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 700;
}

.metric-card > strong {
    color: var(--gray-900);
    font-size: clamp(20px, 5vw, 28px);
    line-height: 1.2;
}

.metric-card > small {
    color: var(--text-muted);
}

.quick-action {
    flex-direction: row;
    justify-content: flex-start;
    min-height: 62px;
}

.quick-action-icon {
    width: 34px;
    height: 34px;

    display: grid !important;
    place-items: center;

    border-radius: 11px;
    background: var(--pink-100);
    color: var(--pink-600);
}

.quick-action-icon svg {
    width: 21px !important;
    height: 21px !important;
}

.list-toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 10px;

    margin-bottom: 16px;
}

.list-toolbar select {
    width: auto;
    min-width: 180px;
}

.product-active-status {
    align-self: flex-start;
    margin-top: 7px;
    padding: 3px 8px;

    border-radius: var(--radius-pill);

    font-size: 11px;
    font-weight: 800;
}

.product-active-status.active {
    background: var(--success-light);
    color: var(--success);
}

.product-active-status.inactive {
    background: var(--gray-100);
    color: var(--gray-500);
}

.product-card-actions {
    grid-template-columns: repeat(2, minmax(0, 1fr));
}

.product-card-toggle-button {
    color: var(--warning) !important;
}

.product-card-delete-button,
.danger {
    color: var(--danger) !important;
}

.product-photo-upload {
    min-height: 132px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;

    padding: 18px;

    border: 1px dashed var(--pink-300);
    border-radius: var(--radius-lg);

    background: var(--white);
    color: var(--gray-700);

    text-align: center;
    cursor: pointer;
}

.product-photo-section {
    background: var(--white);
}

.product-photo-upload:hover {
    background: var(--pink-50);
}

.product-photo-upload-icon {
    font-size: 26px;
}

.product-photo-upload span,
.product-variation-batch p {
    color: var(--text-muted);
    font-size: 13px;
}

.product-variants-list {
    display: flex;
    flex-direction: column;
    gap: 9px;

    margin-top: 12px;
}

.variation-color-dot {
    display: inline-block;
    width: 15px;
    height: 15px;
    margin-right: 6px;

    vertical-align: -2px;

    border: 2px solid var(--white);
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--gray-300);
}

.product-variant-quantity-control input {
    width: 76px;
    min-height: 40px;
}

.color-input-row {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 10px;
}

.color-input-row input[type="color"] {
    padding: 5px;
}

.color-preview-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 9px;
}

.color-preview {
    width: 34px;
    height: 34px;
    border: 2px solid var(--white);
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--gray-300);
}

.sales-list,
.finance-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.sale-card,
.finance-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
}

.sale-card > div,
.finance-card > div {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.sale-card span,
.sale-card small,
.finance-card span,
.finance-card small {
    color: var(--text-muted);
    font-size: 13px;
}

.sale-card > strong,
.finance-card > strong {
    flex: 0 0 auto;
    white-space: nowrap;
}

.sale-picker-heading,
.sale-variant-picker > div:first-child {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

.sale-product-picker-list,
.sale-variant-picker > div:last-child {
    margin-top: 12px;
}

.sale-variant-picker-item + .sale-variant-picker-item {
    margin-top: 8px;
}

.sale-items-section {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.sale-items-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.sale-draft-item {
    grid-template-columns: 52px minmax(0, 1fr) auto;
    align-items: center;
}

.sale-draft-item > img,
.sale-draft-item > div:first-child {
    width: 52px;
    height: 66px;
    object-fit: cover;
    border-radius: 10px;
    background: var(--gray-100);
}

.sale-draft-item > div:nth-child(2) {
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.sale-draft-item > div:nth-child(3) {
    display: grid;
    grid-template-columns: 38px 62px 38px;
    gap: 4px;
}

.sale-draft-item > div:nth-child(3) button,
.sale-draft-item > div:nth-child(3) input {
    min-width: 0;
    min-height: 38px;
    padding: 4px;
    text-align: center;
}

.sale-draft-item > strong {
    grid-column: 2;
}

.sale-draft-item > .icon-button {
    grid-column: 3;
    grid-row: 2;
}

.sale-payment,
.sale-notes {
    margin-bottom: 0;
}

.activity-list {
    padding: 4px 18px;

    border: 1px solid var(--border);
    border-radius: var(--radius-xl);

    background: var(--white);
}

.activity-content {
    min-width: 0;
    flex: 1 1 auto;

    display: flex;
    flex-direction: column;
}

.activity-content span,
.activity-item time {
    color: var(--text-muted);
    font-size: 13px;
}

.activity-item time {
    flex: 0 0 auto;
}

.login-footer {
    margin-top: 22px;
    color: var(--text-muted);
    font-size: 13px;
    text-align: center;
}

@media (max-width: 480px) {

    :root {
        --bottom-nav-height: 74px;
        --header-height: 62px;
    }

    body {
        font-size: 15px;
    }

    .header-user-copy #userName {
        max-width: calc(100vw - 150px);
    }

    .section-heading {
        gap: 12px;
    }

    .section-actions {
        max-width: 150px;
    }

    .form-row {
        grid-template-columns: 1fr;
        gap: 0;
    }

    .list-toolbar {
        align-items: stretch;
        flex-direction: column;
        gap: 5px;
    }

    .list-toolbar select {
        width: 100%;
    }

    .app-header-inner {
        min-height: var(--header-height);

        padding:
            7px
            max(12px, env(safe-area-inset-right))
            7px
            max(12px, env(safe-area-inset-left));
    }

    .app-header button,
    .app-header .logout-button {
        min-height: 34px;
        min-width: 58px;

        padding: 5px 11px;

        font-size: 12px;
    }

    .app-content {
        padding:
            18px 16px
            calc(
                var(--bottom-nav-height) +
                env(safe-area-inset-bottom) +
                22px
            );
    }

    section > h1,
    .page-title,
    h1 {
        font-size: 29px;
    }

    section > h2,
    h2 {
        font-size: 22px;
    }


    /* -----------------------------------------
       ACESSOS RÁPIDOS
       ----------------------------------------- */

    .quick-actions,
    .quick-access,
    .quick-access-grid,
    .dashboard-quick-actions {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 8px;
    }

    .quick-actions button,
    .quick-access button,
    .quick-access-grid button,
    .dashboard-quick-actions button,
    .quick-actions a,
    .quick-access a,
    .quick-access-grid a,
    .dashboard-quick-actions a {
        min-height: 54px;

        padding: 9px 8px;

        font-size: 14px;
    }


    /* -----------------------------------------
       PRODUTOS
       ----------------------------------------- */

    .product-grid,
    .products-grid {
        grid-template-columns: 1fr;

        gap: 12px;
    }

    .product-card {
        grid-template-columns:
            108px
            minmax(0, 1fr);

        min-height: 215px;
    }

    .product-card-image-wrapper {
        width: 108px;
        min-width: 108px;

        min-height: 215px;
    }

    .product-card-info {
        padding: 12px;
    }

    .product-card-name {
        font-size: 17px;
    }

    .product-card-details {
        font-size: 13px;
    }

    .product-card-price {
        font-size: 20px;
    }

    .product-card-actions button {
        min-height: 40px;

        font-size: 13px;
    }

    .product-stock-status {
        min-height: 28px;

        padding: 5px 8px;

        font-size: 11px;
    }


    /* -----------------------------------------
       ESTOQUE
       ----------------------------------------- */

    .stock-card {
        grid-template-columns:
            60px
            minmax(0, 1fr)
            auto;

        gap: 9px;

        padding: 10px 11px;
    }

    .stock-card-image-wrapper {
        width: 60px;
        height: 60px;
    }

    .stock-card-quantity {
        min-width: 62px;

        padding: 8px 6px;
    }


    /* -----------------------------------------
       MODAIS
       ----------------------------------------- */

    .modal {
        padding:
            max(8px, env(safe-area-inset-top))
            8px
            max(8px, env(safe-area-inset-bottom))
            8px;
    }

    .modal-content {
        max-height:
            calc(
                100dvh
                -
                env(safe-area-inset-top)
                -
                env(safe-area-inset-bottom)
                -
                16px
            ) !important;

        border-radius: 18px;
    }

    .modal-header {
        padding: 16px 16px 13px;
    }

    .modal-body {
        padding: 16px;
    }

    .modal-content > form {
        padding: 16px;
    }

    .modal-actions {
        gap: 8px;

        padding-top: 13px;
    }

    #saleModal .sale-management {
        padding: 0;
    }

    .sale-draft-item {
        grid-template-columns: 46px minmax(0, 1fr) auto;
        padding: 11px;
    }

    .sale-draft-item > img,
    .sale-draft-item > div:first-child {
        width: 46px;
        height: 60px;
    }

    .sale-draft-item > div:nth-child(3) {
        grid-column: 1 / -1;
        justify-content: start;
    }

    .sale-draft-item > strong {
        grid-column: 2;
    }

    .activity-item {
        align-items: center;
    }

    .activity-item time {
        display: none;
    }


    /* -----------------------------------------
       MENU INFERIOR
       ----------------------------------------- */

    .bottom-navigation .nav-item {
        font-size: 10px !important;
    }

    .bottom-navigation .nav-icon {
        width: 21px !important;
        height: 21px !important;
    }
}


/* =========================================================
   35. TELAS MUITO PEQUENAS
   ========================================================= */

@media (max-width: 360px) {

    .app-content {
        padding-left: 12px;
        padding-right: 12px;
    }

    .product-card {
        grid-template-columns:
            96px
            minmax(0, 1fr);
    }

    .product-card-image-wrapper {
        width: 96px;
        min-width: 96px;
    }

    .product-card-info {
        padding: 10px;
    }

    .product-card-name {
        font-size: 16px;
    }

    .product-card-details {
        font-size: 12px;
    }

    .product-card-actions {
        gap: 5px;
    }

    .product-card-actions button {
        padding-left: 4px;
        padding-right: 4px;

        font-size: 12px;
    }

    .quick-actions button,
    .quick-access button,
    .quick-access-grid button,
    .dashboard-quick-actions button {
        font-size: 13px;
    }

    .bottom-navigation .nav-item {
        font-size: 9px !important;
    }

    .bottom-navigation .nav-icon {
        width: 19px !important;
        height: 19px !important;
    }
}


/* =========================================================
   36. TABLET
   ========================================================= */

@media (min-width: 700px) {

    .app-content {
        padding:
            30px 24px
            calc(
                var(--bottom-nav-height) +
                env(safe-area-inset-bottom) +
                30px
            );
    }

    .form-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

    .product-grid,
    .products-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 18px;
    }

    .product-card {
        grid-template-columns:
            120px
            minmax(0, 1fr);
    }

    .product-card-image-wrapper {
        width: 120px;
        min-width: 120px;
    }

    .category-grid,
    .categories-grid,
    .color-grid,
    .colors-grid,
    .size-grid,
    .sizes-grid {
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
    }

    .modal-content {
        max-width: 680px !important;
    }

    #saleModal .modal-content {
        max-width: 760px !important;
    }
}


/* =========================================================
   37. DESKTOP
   ========================================================= */

@media (min-width: 1024px) {

    .app-header-inner {
        padding-left: 28px;
        padding-right: 28px;
    }

    .app-content {
        padding:
            34px 30px
            calc(
                var(--bottom-nav-height) +
                34px
            );
    }

    .product-grid,
    .products-grid {
        grid-template-columns:
            repeat(3, minmax(0, 1fr));
    }

    .dashboard-grid,
    .summary-grid,
    .stats-grid,
    .metrics-grid {
        grid-template-columns:
            repeat(4, minmax(0, 1fr));
    }

    .category-grid,
    .categories-grid,
    .color-grid,
    .colors-grid,
    .size-grid,
    .sizes-grid {
        grid-template-columns:
            repeat(4, minmax(0, 1fr));
    }

    .bottom-navigation {
        padding-left: 20px !important;
        padding-right: 20px !important;
    }

    .bottom-navigation .nav-item {
        flex: 0 1 180px !important;

        font-size: 12px !important;
    }
}


/* =========================================================
   38. REDUÇÃO DE MOVIMENTO
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

    html {
        scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;

        transition-duration: 0.01ms !important;
    }
}

/* Acabamento dos componentes usados pelo HTML e pelos renderizadores. */
.ui-icon, .header-avatar svg, .product-photo-upload-icon svg {
    width: 24px;
    height: 24px;
    flex: 0 0 auto;
}
.app-header { padding-top: env(safe-area-inset-top); }
.header-profile { flex: 1; }
.app-header .logout-button { flex: 0 0 auto; min-height: 44px; }
.login-card .primary-button { width: 100%; }
.login-card h1 { font-family: Georgia, serif; font-weight: 500; }
.app-section { min-width: 0; }
.section-heading > div { min-width: 0; }
.section-heading { flex-wrap: wrap; }
.section-heading h2 { overflow-wrap: anywhere; }
.section-heading > button { flex-shrink: 0; }
.section-block { margin-top: 24px; padding-top: 18px; }
.metric-card { min-width: 0; padding: 16px; box-shadow: none; }
.metric-card > strong { font-size: clamp(18px, 4.8vw, 26px); overflow-wrap: anywhere; }
#metricSales, #financeIncome { color: var(--success); }
#metricExpenses, #financeExpenses { color: var(--danger); }
#homeScreen .section-block h3 { margin-top: 0; }
.product-card { border-radius: 14px; box-shadow: none; }
.product-card-image-wrapper { min-height: 0; height: 100%; }
.product-card-image { position: absolute; inset: 0; object-fit: contain; }
.product-card-info { padding: 12px; }
.product-card-name { font-size: 16px; font-weight: 700; }
.product-card-price { margin-top: 6px; padding-top: 0; font-size: 19px; }
.product-card-stock { flex-wrap: wrap; margin-top: 7px; }
.product-card-details { margin-top: 5px; font-size: 12px; overflow-wrap: anywhere; }
.product-card-actions { gap: 6px; margin-top: 10px; }
.product-card-actions button { font-size: 12px; min-height: 44px; padding: 5px; }
.product-stock-status { min-height: 24px; padding: 4px 7px; font-size: 11px; }
.product-stock-status.inactive { color: var(--gray-600); background: var(--gray-100); }
.product-card-actions button:hover { background: var(--pink-50); }
button:disabled { cursor: not-allowed; opacity: .55; }
.stock-card-info small { display: block; color: var(--text-muted); }
.stock-card-image-wrapper { height: 80px; border-radius: 9px; }
.stock-card-image { object-fit: contain; }
.categories-grid, .colors-grid, .sizes-grid { grid-template-columns: 1fr; }
.category-card-info, .color-card-text, .size-card-info { overflow-wrap: anywhere; min-width: 0; }
.category-card-actions, .color-card-actions, .size-card-actions { flex-shrink: 0; }
.size-card-order { display: block; }
.icon-button { width: 44px; height: 44px; min-width: 44px; min-height: 44px; }
.product-variant-draft-item { flex-wrap: wrap; }
.product-variant-draft-info { display: flex; align-items: center; gap: 6px; overflow-wrap: anywhere; }
.product-variant-draft-actions { margin-left: auto; }
.product-photo-section:focus-within .product-photo-upload { outline: 2px solid var(--pink-700); outline-offset: 3px; }
.product-photo-preview-name { display: block; }
.product-existing-photo small { display: block; padding: 5px 8px; }
.sale-product-picker { padding: 12px; }
.sale-product-picker-item { grid-template-columns: 42px minmax(0, 1fr); gap: 8px; }
.sale-product-picker-image { width: 42px; height: 60px; grid-row: span 2; object-fit: contain; }
.sale-product-picker-item > strong { grid-column: 2; color: var(--pink-700); }
.sale-product-picker-item strong { font-size: 14px; overflow-wrap: anywhere; }
.sale-product-picker-item small { display: block; }
.sale-variant-picker-item { width: 100%; flex-wrap: wrap; font-size: 14px; text-align: left; }
.sale-draft-item > div:nth-child(2) { overflow-wrap: anywhere; font-size: 14px; }
.sale-draft-item > div:nth-child(3) { grid-column: 1 / -1; grid-row: 2; grid-template-columns: 44px 58px 44px; }
.sale-draft-item > div:nth-child(3) button,
.sale-draft-item > div:nth-child(3) input { min-height: 44px; border: 1px solid var(--border); border-radius: 8px; background: var(--white); }
.sale-draft-item > strong { grid-column: 2 / 4; grid-row: 3; text-align: right; }
.sale-draft-item > .icon-button { grid-column: 3; grid-row: 1; }
.sale-card, .finance-card { flex-wrap: wrap; padding: 14px; border-radius: 14px; box-shadow: none; }
.sale-card > div, .finance-card > div { overflow-wrap: anywhere; flex: 1 1 150px; }
.sale-card > strong, .finance-card > strong { margin-left: auto; }
.activity-content { overflow-wrap: anywhere; font-size: 14px; }
.activity-icon { width: 34px; height: 34px; }
.activity-item { flex-wrap: wrap; gap: 9px; }
.activity-item time { display: block; font-size: 11px; }
.modal-content [aria-busy="true"] { opacity: .7; }
@media (max-width: 480px) {
    .product-card { min-height: 0; grid-template-columns: 88px minmax(0, 1fr); }
    .product-card-image-wrapper { min-height: 0; width: 88px; min-width: 88px; }
    .product-card-name { font-size: 15px; }
    .activity-item time { margin-left: 43px; width: calc(100% - 43px); margin-top: -7px; }
    .section-actions { max-width: none; }
    .section-actions .small { padding: 8px 10px; }
    #financeScreen .metric-card:last-child { grid-column: 1 / -1; }
    .sale-management-footer .primary-button { padding-inline: 10px; font-size: 14px; }
}
@media (min-width: 700px) {
    .categories-grid, .colors-grid, .sizes-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .product-card { grid-template-columns: 100px minmax(0, 1fr); }
    .product-card-image-wrapper { width: 100px; min-width: 100px; }
    .stock-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (min-width: 1024px) {
    .products-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .product-card { grid-template-columns: 130px minmax(0, 1fr); }
    .product-card-image-wrapper { width: 130px; min-width: 130px; }
    .product-card-actions { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    #financeScreen .metrics-grid, #stockScreen .metrics-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    #salesScreen .metrics-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 480px) {
    .bottom-navigation .nav-item { font-size: 11px !important; }
    #stockScreen .metric-card:last-child { grid-column: 1 / -1; }
}
.variation-heading h3 { margin: 0 0 6px; }
.variation-heading p { margin: 0; font-size: 14px; font-weight: 400; color: var(--text-muted); }
.sale-product-picker-item > span > strong { color: var(--text); }
@media (max-width: 480px) {
    #stockScreen .metrics-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    #stockScreen .metric-card { padding: 12px 10px; }
    #stockScreen .metric-card:last-child { grid-column: auto; }
    #stockScreen .metric-card > span, #stockScreen .metric-card > small { font-size: 12px; }
}

/* Gestão mobile: hierarquia compacta e estados de trabalho. */
:root { --header-height: 58px; --bottom-nav-height: 66px; --text-muted: #6e6267; }
.app-content { padding-top: 16px; }
.app-header-inner { min-height: 58px; gap: 8px; }
.header-profile { gap: 8px; }
.header-avatar { width: 30px; height: 30px; }
.header-avatar svg { width: 19px; height: 19px; }
.header-user-copy { flex: 1; }
.header-user-copy #userName { max-width: 100%; font-size: 12px; font-weight: 500; }
.app-header .app-greeting { font-size: 11px; color: var(--text); font-weight: 700; }
.app-header button { min-width: 44px; min-height: 44px; padding: 6px 9px; font-size: 12px; }
.app-header .header-settings { margin-left: auto; }
.section-heading { margin-bottom: 14px; gap: 8px; align-items: center; }
.section-heading h2 { font-size: 23px; letter-spacing: -.5px; }
.section-eyebrow { font-size: 10px; letter-spacing: 1.2px; }
.section-block { margin-top: 18px; padding-top: 0; border-top: 0; }
.section-block h3, .subsection-heading h3 { font-size: 16px; }
.subsection-heading { margin-bottom: 9px; }
.section-heading p, .field-hint { font-size: 12px; color: var(--text-muted); }
.primary-button, .secondary-button { box-shadow: none; min-height: 44px; font-size: 14px; padding: 9px 14px; }
.text-button { border: 0; background: transparent; color: var(--pink-700); min-height: 44px; padding: 7px 4px; font-size: 13px; font-weight: 700; text-align: left; }
.metrics-grid { gap: 9px; margin-bottom: 12px; }
.metric-card { padding: 12px; border-radius: 12px; }
.metric-card > span, .metric-card > small { font-size: 12px; }
.metric-card > strong { font-size: clamp(18px, 4.7vw, 24px); margin: 3px 0; line-height: 1.25; }
.day-result { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 12px; border: 1px solid var(--border); border-radius: 12px; background: white; text-align: left; }
.day-result > span:first-child { font-size: 13px; font-weight: 700; }
.day-result small { display: block; font-size: 11px; font-weight: 400; color: var(--text-muted); }
.day-result strong { margin-left: auto; font-size: 20px; white-space: nowrap; }
.quick-actions { margin-bottom: 0; gap: 8px; }
.quick-actions button { min-height: 48px; justify-content: flex-start; padding: 8px 10px; border-radius: 12px; box-shadow: none; font-size: 13px; }
.quick-action-icon { width: 30px; height: 30px; border-radius: 9px; }
.stock-alert-row { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 10px; background: white; border: 1px solid var(--border); padding: 10px 12px; text-align: left; border-radius: 10px; margin-bottom: 6px; }
.stock-alert-row > span:first-child { min-width: 0; }
.stock-alert-row strong { display: block; font-size: 13px; overflow-wrap: anywhere; }
.stock-alert-row small { display: block; color: var(--text-muted); font-size: 12px; }
.status-badge { display: inline-flex; width: fit-content; align-items: center; padding: 3px 7px; border-radius: 6px; font-size: 11px; font-weight: 600; background: var(--gray-100); color: var(--gray-600); }
.status-badge.normal, .status-text.normal { background: var(--success-light); color: var(--success); }
.status-badge.low, .status-text.low { background: var(--warning-light); color: var(--warning); }
.status-badge.zero, .status-text.zero { background: var(--danger-light); color: var(--danger); }
.stock-alert-row > .status-badge { flex-shrink: 0; }
.activity-list { padding: 0 12px; border-radius: 12px; }
.activity-item { padding: 10px 0; }
.activity-content { font-size: 13px; }
.activity-icon.income { background: var(--success-light); color: var(--success); }
.activity-icon.expense { background: var(--danger-light); color: var(--danger); }
.empty-state, .empty-state.compact { min-height: 0; padding: 18px 12px; border-radius: 12px; gap: 5px; }
.empty-state strong { font-size: 14px; margin: 0; }
.empty-state p { font-size: 13px; }
.empty-state-icon { width: 32px; height: 32px; margin-bottom: 4px; }
.empty-state button { margin-top: 5px; }
.filter-chips { display: flex; gap: 6px; margin: 10px 0 12px; min-width: 0; }
.filter-chips button { flex: 1; min-width: 0; border: 1px solid var(--border); background: white; color: var(--text-muted); border-radius: 9px; padding: 8px 5px; font-size: 12px; font-weight: 600; white-space: nowrap; }
.filter-chips button[aria-pressed="true"] { background: var(--pink-100); border-color: var(--pink-300); color: var(--pink-700); }
.search-input { margin-bottom: 0; }
.product-card { grid-template-columns: 78px minmax(0, 1fr); padding: 10px; gap: 10px; align-items: start; }
.product-card-image-wrapper { width: 78px; min-width: 0; height: 112px; border-radius: 8px; }
.product-card-info { padding: 0; }
.product-card-name { font-size: 15px; margin-bottom: 2px; }
.product-card-sku, .product-card-category { font-size: 11px; }
.product-card-price { font-size: 17px; margin-top: 3px; }
.product-card-stock { margin-top: 4px; gap: 6px; font-size: 12px; }
.product-card-actions { grid-template-columns: 1fr 1fr 48px; margin-top: 7px; gap: 5px; }
.product-card-actions button { border-radius: 8px; }
.product-more { min-width: 0; }
.product-more > summary { list-style: none; min-height: 44px; display: grid; place-items: center; font-size: 12px; font-weight: 700; color: var(--text-muted); cursor: pointer; }
.product-more > summary::-webkit-details-marker { display: none; }
.product-more[open] { grid-column: 1 / -1; }
.product-more[open] > summary { justify-content: start; }
.product-more > div { display: flex; gap: 6px; }
.product-more > div > button { flex: 1; }
.stock-card { padding: 10px; gap: 9px; border-radius: 12px; box-shadow: none; grid-template-columns: 48px minmax(0, 1fr) auto; }
.stock-card-image-wrapper { width: 48px; height: 70px; }
.stock-card-info strong { font-size: 14px; }
.stock-card-info span { font-size: 12px; }
.stock-card-info .status-text { display: inline; font-size: 11px; border-radius: 4px; padding: 2px 4px; }
.stock-card-info .text-button { display: block; margin-bottom: -7px; font-size: 12px; }
.stock-card-quantity { min-width: 55px; padding: 7px; }
.stock-card-quantity strong { display: block; font-size: 20px; }
.stock-card-quantity small { display: block; font-size: 10px; }
#financeScreen .list-toolbar { flex-direction: row; align-items: center; gap: 10px; margin-bottom: 12px; }
#financeScreen .list-toolbar select { flex: 1; width: auto; min-width: 0; }
#financeScreen .metric-card:last-child { grid-column: 1 / -1; display: flex; align-items: center; flex-wrap: wrap; column-gap: 12px; }
#financeScreen .metric-card:last-child strong { margin-left: auto; }
#financeScreen .metric-card:last-child small { flex-basis: 100%; }
.sale-card, .finance-card { padding: 12px; gap: 8px; }
.sale-card > div, .finance-card > div { flex-basis: 130px; }
.sale-card > div > strong, .finance-card > div > strong { font-size: 14px; }
.sale-card .status-badge { margin-top: 3px; font-size: 11px; }
#registrationFilters { position: sticky; top: 0; z-index: 2; background: var(--background); padding: 6px 0; }
#settingsScreen .section-block { margin-top: 12px; }
.category-card, .color-card, .size-card { padding: 11px; border-radius: 12px; box-shadow: none; }
.category-card-info strong, .color-card-name { font-size: 14px; }

/* Formulários: campos essenciais visíveis, detalhes opcionais recolhidos. */
.login-logo, .login-card img { width: 92px; height: 92px; margin-bottom: 16px; }
.login-card h1 { font-size: 34px; }
.login-card .login-subtitle { max-width: 280px; margin: 0 auto 24px; font-size: 15px; color: var(--text-muted); }
.password-field { position: relative; }
.password-field input { padding-right: 78px; }
.password-field button { position: absolute; right: 3px; top: 2px; min-height: 44px; background: transparent; border: 0; color: var(--pink-700); font-size: 12px; }
.form-group { margin-bottom: 13px; gap: 5px; }
.form-group label, .product-variation-field label { font-size: 13px; }
input, select, textarea { min-height: 46px; padding: 10px 11px; border-radius: 10px; font-size: 16px; }
textarea { min-height: 74px; }
.form-row { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.form-row > * { min-width: 0; }
.checkbox-label { min-height: 44px; font-size: 13px; }
.optional-fields, .product-variation-batch { display: block; border-top: 1px solid var(--border); margin: 8px 0 12px; }
.optional-fields > summary, .product-variation-batch > summary { min-height: 44px; padding: 12px 2px; cursor: pointer; font-size: 13px; font-weight: 600; }
.optional-fields > summary span { font-size: 11px; font-weight: 400; color: var(--text-muted); margin-left: 5px; }
#productFormTabs { margin-top: 0; flex-shrink: 0; }
.product-panel { flex-shrink: 0; }
.variation-section { padding: 0; margin-top: 8px; border: 0; border-radius: 0; background: white; }
.variation-heading h3 { font-size: 16px; }
.variation-heading p { font-size: 12px; }
.product-variation-form { grid-template-columns: 1fr 1fr; align-items: end; gap: 9px; }
.product-variation-form > button { font-size: 12px; padding: 8px; }
.product-variant-draft-item { padding: 9px; gap: 6px; }
.product-variant-draft-info { font-size: 13px; }
.product-variant-quantity-control span { font-size: 11px; }
.product-variant-quantity-control input { width: 58px; min-height: 44px; padding: 5px; }
.product-photo-upload { padding: 16px; min-height: 100px; }
.camera-button { width: 100%; margin-bottom: 10px; cursor: pointer; }
.photo-remove { width: 100%; border: 0; border-top: 1px solid var(--border); border-radius: 0; background: white; color: var(--danger); font-size: 12px; }
.modal-header { align-items: center; padding: 12px 14px; }
.modal-header h2 { font-size: 19px; }
.modal-header button { min-width: 44px; min-height: 44px; width: 44px; height: 44px; border-radius: 10px; background: white; border-color: var(--border); }
.modal-header .section-eyebrow { display: none; }
.modal-content > form, .modal-body { padding: 14px; }
.modal-actions { position: sticky; bottom: -14px; z-index: 3; padding: 10px 0 max(10px, env(safe-area-inset-bottom)); margin-top: auto; background: white; box-shadow: 0 -8px 0 white; }
.form-message { padding: 10px; font-size: 13px; flex-shrink: 0; }
#dataLoadError { margin: 0; padding: 12px; background: var(--warning-light); color: var(--warning); font-size: 13px; }
.app-toast { position: fixed; z-index: 2000; left: 16px; right: 16px; bottom: calc(var(--bottom-nav-height) + env(safe-area-inset-bottom) + 10px); max-width: 520px; margin: 0 auto; background: var(--gray-800); color: white; border-radius: 12px; padding: 12px 16px; box-shadow: var(--shadow-md); font-size: 14px; pointer-events: none; }
body.modal-open .app-toast { bottom: calc(16px + env(safe-area-inset-bottom)); }

/* Venda: carrinho, seleção e pagamento são estados exclusivos. */
#saleModal #saleManagementWorkspace { overflow: visible; }
.sale-management { gap: 12px; }
.sale-management-actions button { width: 100%; }
.sale-management.picking > :not(.sale-product-picker) { display: none !important; }
.sale-product-picker { background: white; border: 0; border-radius: 0; padding: 0; }
.sale-picker-heading { margin-bottom: 10px; font-size: 14px; }
.sale-product-picker-item { padding: 10px; grid-template-columns: 48px minmax(0, 1fr) auto; border-radius: 12px; }
.sale-product-picker-image { width: 48px; height: 68px; grid-row: auto; }
.sale-product-picker-item > strong { grid-column: auto; font-size: 13px; }
.sale-product-picker-item small { font-size: 12px; }
.variant-product-heading { margin: 8px 0; }
.variant-color-groups { display: flex; flex-direction: column; gap: 14px; }
.variant-color-group h3 { margin: 8px 0; font-size: 14px; }
.variant-size-options { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
.sale-variant-picker-item { flex-direction: column; justify-content: center; align-items: center; padding: 10px 5px; gap: 3px; min-height: 68px; }
.sale-variant-picker-item + .sale-variant-picker-item { margin-top: 0; }
.sale-variant-picker-item strong { font-size: 16px; }
.sale-variant-picker-item span { font-size: 11px; }
.sale-variant-picker-item:disabled { background: var(--gray-100); color: var(--text-muted); opacity: .7; border-style: dashed; }
.sale-cart-footer { display: flex; justify-content: space-between; align-items: center; gap: 10px; position: sticky; bottom: -14px; padding: 12px 0; background: white; border-top: 1px solid var(--border); }
.sale-cart-footer small, .sale-cart-footer strong { display: block; }
.sale-cart-footer small { font-size: 11px; color: var(--text-muted); }
.sale-cart-footer strong { font-size: 19px; }
.sale-summary { border-radius: 12px; padding: 12px; }
.sale-summary .total { color: var(--text); }
.sale-management-footer { position: sticky; bottom: -14px; padding: 12px 0; background: white; }
.sale-draft-item { padding: 10px; gap: 8px; border-radius: 12px; }
.sale-draft-item > div:nth-child(3) { grid-column: 1 / 3; }
.sale-draft-item > strong { grid-column: 3; grid-row: 2; font-size: 14px; align-self: center; }

@media (max-width: 699px) {
    .modal { align-items: flex-end !important; padding: max(8px, env(safe-area-inset-top)) 0 0; }
    .modal-content { margin: 0 !important; border-radius: 18px 18px 0 0; max-height: calc(100dvh - env(safe-area-inset-top) - 8px) !important; }
    #productModal .modal-content, #saleModal .modal-content { height: calc(100dvh - env(safe-area-inset-top) - 8px); }
    #saleModal .modal-body { padding-bottom: max(14px, env(safe-area-inset-bottom)); }
    .app-content { padding-inline: max(12px, env(safe-area-inset-left)); }
    #stockScreen .metrics-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    #stockScreen .metric-card:last-child { grid-column: auto; }
}
@media (min-width: 700px) {
    .app-content { max-width: 1100px; }
    .filter-chips { max-width: 480px; }
    #productFormTabs { max-width: none; }
    .product-card { grid-template-columns: 90px minmax(0, 1fr); }
    .product-card-image-wrapper { width: 90px; height: 130px; }
    .modal-content { max-width: 600px !important; }
    #productModal .modal-content, #saleModal .modal-content { min-height: 580px; }
    #homeScreen .quick-actions { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    #financeScreen .metrics-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-height: 550px) {
    .login-page { align-items: flex-start; padding-top: 14px; }
    .login-logo, .login-card img { width: 54px; height: 54px; margin-bottom: 6px; }
    .login-card .login-subtitle { margin-bottom: 12px; }
}
summary:focus-visible { outline: 3px solid var(--pink-700); outline-offset: 2px; border-radius: 6px; }
/* Refinos após inspeção em 360 px. */
#financeScreen .metric-card:last-child { flex-direction: row; justify-content: space-between; }
#financeScreen .metric-card:last-child small { flex-basis: 100%; }
#financeScreen .metric-card:last-child strong { margin-left: auto; }
body.modal-open .app-toast { top: calc(72px + env(safe-area-inset-top)); bottom: auto; }
@media (max-width: 699px) {
    .header-user-copy .app-greeting { font-size: 10px; }
    .header-user-copy #userName { font-size: 11px; }
    .app-header .header-settings { padding-inline: 7px; min-width: 44px; font-size: 11px; }
    .metric-card { min-height: 0; }
}
.primary-button.small, .secondary-button.small { min-height: 44px; }

#financeBalance.income { color: var(--success); }
#financeBalance.expense { color: var(--danger); }
.camera-button { border-radius: 10px; }
#saleModal .sale-management { min-height: 100%; }
.sale-cart-footer, .sale-management-footer { margin-top: auto; }

.finance-actions { margin-top: 8px; }
.finance-actions summary { min-height: 44px; padding: 12px 0; cursor: pointer; font-size: 12px; color: var(--text-muted); }
.finance-actions .secondary-button { margin-top: 8px; }
.finance-actions small { white-space: normal; overflow-wrap: anywhere; }
.destructive-button { background: var(--danger); color: white; border: 1px solid var(--danger); border-radius: 10px; min-height: 44px; padding: 9px 14px; font-weight: 700; }
#deleteFinanceSummary, #deleteFinanceExplanation { overflow-wrap: anywhere; margin: 0 0 16px; }

button.sale-card { width: 100%; text-align: left; color: var(--text); cursor: pointer; }
.sale-card > .sale-card-info { min-width: 0; display: flex; flex-direction: column; gap: 2px; flex: 1 1 130px; overflow-wrap: anywhere; }
.sale-card-info > strong { font-size: 14px; color: var(--text); }
.sale-card .sale-details-hint { margin-top: 4px; color: var(--pink-700); }
#saleDetailsContent { overflow-wrap: anywhere; }
#saleDetailsContent h3 { margin: 18px 0 8px; font-size: 15px; }
.sale-details-summary { margin: 14px 0; }
.sale-details-summary > div { display: flex; justify-content: space-between; gap: 12px; margin: 8px 0; }
.sale-details-summary dt { color: var(--text-muted); }
.sale-details-summary dd { margin: 0; text-align: right; }
.sale-details-items { list-style: none; padding: 0; margin: 0; }
.sale-details-items li { display: flex; flex-direction: column; gap: 4px; padding: 12px 0; border-bottom: 1px solid var(--border); }
.sale-details-items span { color: var(--text-muted); font-size: 13px; }
.sale-details-text { white-space: pre-wrap; }
.sale-details-actions { margin-top: 16px; padding-top: 8px; border-top: 1px solid var(--border); color: var(--text-muted); }

/* Gerenciamento de cores: controles de toque, sem depender de hover. */
.pc-tabs { flex-wrap: wrap; overflow: visible; }
.pc-tabs button { display: flex; flex-direction: column; align-items: flex-start; white-space: normal; }
.pc-tabs small { font-size: .7rem; font-weight: 400; }
.pc-actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0; }
.pc-actions button, .pc-photo button, .pc-choices button { min-height: 44px; padding: 8px 12px; border: 1px solid var(--border-color, #ddd); border-radius: 10px; background: var(--surface, #fff); color: inherit; }
.pc-photo button[aria-pressed="true"] { background: #f8e6ed; color: #702044; }
.pc-size { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; padding: 10px 0; border-bottom: 1px solid #eee; }
.pc-size label { display: flex; align-items: center; gap: 8px; min-height: 44px; }
.pc-size input[type="number"] { width: 85px; min-height: 44px; }
.pc-size input[type="checkbox"] { width: 24px; height: 24px; }
.pc-photo { min-width: 0; display: flex; flex-direction: column; gap: 8px; }
.pc-photo > img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 12px; }
.pc-photo select { width: 100%; min-height: 44px; }
#productPhotoPreview { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; }
.pc-gallery { display:flex; overflow-x:auto; gap:8px; padding: 8px 0; }
.pc-gallery img { width: 140px; height: 160px; object-fit:cover; border-radius:12px; }

.pc-swatch { display: inline-block; width: 16px; height: 16px; flex-shrink: 0; border-radius: 50%; border: 1px solid #ccc; vertical-align: middle; }
.pc-picker-image { display: inline-block; width: 44px; height: 48px; object-fit: cover; border-radius: 8px; vertical-align: middle; }

/* Etapa 2: paleta, uma cor por vez e fotos compactas. Escopo do modal. */
#productModal [data-product-panel="colors"] { background: #fffafb; padding-top: 16px; padding-bottom:24px; }
#productModal .pc-palette-heading { display:flex; align-items:baseline; justify-content:space-between; gap:12px; margin-bottom:12px; }
#productModal .pc-palette-heading h3 { font-size:16px; margin:0; }
#productModal .pc-palette-heading > span, #productModal .pc-photo-heading > span { font-size:11px; color:var(--text-muted); }
#productModal .pc-palette { display:grid; grid-template-columns:repeat(auto-fit,minmax(58px,1fr)); gap:8px; }
#productModal .pc-palette button { position:relative; display:flex; flex-direction:column; align-items:center; gap:7px; min-height:78px; padding:8px 3px; background:transparent; border:0; border-radius:12px; font-size:12px; color:var(--text); overflow-wrap:anywhere; }
#productModal .pc-palette .pc-swatch { width:36px; height:36px; border:1px solid #d6c9ce; box-shadow:0 0 0 3px white; }
#productModal .pc-palette button[aria-pressed="true"] { background:#f9eaf0; color:var(--pink-700); font-weight:700; }
#productModal .pc-palette button[aria-pressed="true"] .pc-swatch { outline:2px solid var(--pink-500,#c96f8c); outline-offset:3px; }
#productModal .pc-palette-check { position:absolute; top:2px; right:calc(50% - 25px); display:grid; place-items:center; background:var(--pink-700); color:white; border-radius:50%; width:18px; height:18px; font-size:12px; }
#productModal .pc-secondary-choice button { font-size:12px; min-height:44px; padding:6px 0; color:var(--text-muted); }
#productModal .pc-navigation-heading { font-size:10px; letter-spacing:.08em; text-transform:uppercase; font-weight:700; color:var(--text-muted); margin:12px 0 8px; }
#productModal .pc-tabs { gap:7px; margin-bottom:16px; }
#productModal .pc-tabs button { flex-direction:row; align-items:center; gap:6px; min-height:44px; padding:8px 10px; border-radius:24px; }
#productModal .pc-tabs small { font-weight:700; font-size:12px; border-left:1px solid #e8ccd7; padding-left:7px; }
#productModal .pc-editor-card { background:white; border:1px solid #efdee5; border-radius:18px; padding:14px; min-width:0; }
#productModal .pc-card-heading { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:10px; }
#productModal .pc-card-heading h3 { display:flex; gap:8px; align-items:center; margin:0; font-size:17px; overflow-wrap:anywhere; }
#productModal .pc-color-options { position:relative; }
#productModal .pc-color-options summary { min-width:44px; min-height:44px; display:grid; place-items:center; cursor:pointer; border-radius:12px; color:var(--text-muted); }
#productModal .pc-color-options > div { position:absolute; right:0; top:44px; z-index:3; width:210px; background:white; border:1px solid var(--border); border-radius:12px; padding:12px; box-shadow:0 5px 16px #39232d14; }
#productModal .pc-photo-heading { display:flex; align-items:baseline; justify-content:space-between; gap:8px; margin:8px 0; }
#productModal h4 { font-size:13px; margin:0; }
#productModal #productPhotoPreview { grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; align-items:start; }
#productModal .pc-photo { position:relative; gap:0; }
#productModal .pc-photo-image { position:relative; aspect-ratio:4/5; overflow:hidden; border-radius:10px; background:#f8f3f5; }
#productModal .pc-photo-image img { width:100%; height:100%; object-fit:cover; }
#productModal .pc-photo-badge { position:absolute; bottom:5px; left:4px; right:4px; text-align:center; border-radius:6px; padding:3px 1px; background:#fffffff0; font-size:9px; font-weight:700; color:var(--pink-700); }
#productModal .pc-photo-options summary { min-height:44px; display:grid; place-items:center; font-size:11px; color:var(--pink-700); cursor:pointer; }
#productModal .pc-photo-options > div { position:absolute; top:100%; left:0; z-index:4; width:220px; max-width:calc(100vw - 70px); border:1px solid var(--border); background:white; padding:10px; border-radius:12px; box-shadow:0 5px 16px #39232d14; display:flex; flex-direction:column; gap:8px; }
#productModal .pc-photo:nth-child(3n) .pc-photo-options > div, #productModal .pc-photo:nth-child(3n + 2) .pc-photo-options > div { left:auto; right:0; }
#productModal .pc-photo-options label { font-size:12px; }
#productModal .pc-photo-options select { font-size:16px; }
#productModal .pc-add-photo { aspect-ratio:4/5; min-height:96px; border:1px dashed #dfb7c8; background:#fff7fa; color:var(--pink-700); border-radius:10px; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:5px; font-size:10px; }
#productModal .pc-add-photo > span { font-size:28px; font-weight:300; }
#productModal .pc-photo-sources { display:flex; flex-wrap:wrap; gap:8px; margin:4px 0 18px; }
#productModal .pc-photo-sources button { min-height:44px; padding:6px 10px; background:#fff; color:var(--pink-700); border:1px solid #eed7e1; border-radius:10px; font-size:12px; }
#productModal .pc-size { display:grid; grid-template-columns:minmax(24px,1fr) auto auto; gap:6px; min-height:60px; padding:8px 0; }
#productModal .pc-size > strong { font-size:14px; overflow-wrap:anywhere; }
#productModal .pc-size-toggle { cursor:pointer; font-size:11px; color:var(--pink-700); padding:0 7px; min-height:44px; border-radius:8px; }
#productModal .pc-size-toggle:has(input:focus-visible) { outline:2px solid var(--pink-700); }
#productModal .pc-size-toggle:has(input:not(:checked)) { grid-column:3; background:#fff3f8; padding:0 14px; }
#productModal .pc-size > small { grid-column:1/-1; font-size:11px; color:var(--text-muted); }
#productModal .pc-stepper { display:flex; align-items:center; background:#fbf6f8; border-radius:12px; border:1px solid #eedfe5; }
#productModal .pc-stepper button { width:44px; min-height:44px; padding:0; border:0; background:transparent; color:var(--pink-700); font-size:22px; }
#productModal .pc-stepper button:disabled { opacity:.3; }
#productModal .pc-stepper input { width:44px; min-height:44px; padding:0; text-align:center; border:0; background:transparent; border-radius:0; font-size:16px; appearance:textfield; -moz-appearance:textfield; }
#productModal .pc-stepper input::-webkit-inner-spin-button { -webkit-appearance:none; }
#productModal .pc-color-total { font-size:12px; text-align:right; margin:12px 0 0; color:var(--text-muted); }
#productModal .pc-total { text-align:right; font-size:13px; font-weight:700; padding:14px 2px 0; margin:0; }
#productModal .pc-cover-preview { display:flex; align-items:center; gap:12px; margin:0 0 16px; }
#productModal .pc-cover-preview > img { width:76px; height:96px; object-fit:cover; border-radius:10px; }
#productModal .pc-cover-preview strong, #productModal .pc-cover-preview small { display:block; }
#productModal .pc-cover-preview small, #productModal .pc-cover-preview p { font-size:12px; color:var(--text-muted); line-height:1.5; }
#productModal .pc-cover-preview p { margin:6px 0 0; }
@media(min-width:600px) {
 #productModal #productPhotoPreview { grid-template-columns:repeat(3,minmax(0,1fr)); }
 #productModal .pc-photo-image, #productModal .pc-add-photo { max-height:170px; }
}
#productModal .pc-palette { grid-template-columns:repeat(auto-fill,minmax(58px,1fr)); }
#productModal .pc-tabs button { flex:0 1 auto; max-width:100%; }
#productModal .pc-tabs button > span:not(.pc-swatch) { min-width:0; overflow-wrap:anywhere; }
#productModal .pc-tabs small { flex-shrink:0; }
#productModal .pc-photo:nth-child(3n + 2) .pc-photo-options > div { left:50%; right:auto; transform:translateX(-50%); }

#productModal #productForm { scroll-padding-block:12px 100px; }

/* Seletor visual do catálogo de cores. */
#colorModal .color-editor { margin-bottom: 20px; }
#colorModal .color-editor-preview { height: 100px; border-radius: 16px; border: 1px solid var(--gray-300); margin-bottom: 16px; }
#colorModal .color-input-row { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); align-items: start; }
#colorModal .color-input-row .form-group { margin: 0; min-width: 0; }
#colorModal .color-native-label { display: grid; gap: 8px; font-size: 14px; font-weight: 600; }
#colorModal input[type="color"] { width: 100%; height: 48px; cursor: pointer; }
#colorModal .color-rgb-controls { border: 0; padding: 0; margin: 20px 0 0; min-width: 0; }
#colorModal .color-rgb-controls legend { font-weight: 600; font-size: 14px; margin-bottom: 8px; }
#colorModal .color-rgb-row { display: grid; grid-template-columns: 24px minmax(0, 1fr) 72px; gap: 10px; align-items: center; margin-top: 8px; }
#colorModal .color-rgb-row label { margin: 0; font-weight: 600; }
#colorModal .color-rgb-row input[type="range"] { padding: 0; min-width: 0; width: 100%; height: 44px; accent-color: var(--pink-600); cursor: pointer; }
#colorModal .color-rgb-row input[type="number"] { min-width: 0; min-height: 44px; padding: 8px; text-align: center; }

/* Estoque resumido por produto, com detalhe por cor. */
.stock-product-card { align-items: start; gap: 12px; grid-template-columns: 58px minmax(0, 1fr) auto; }
.stock-product-card > .stock-card-image { width: 58px; height: 82px; flex: 0 0 58px; object-fit: cover; border-radius: 10px; }
.stock-product-card .stock-card-info { min-width: 0; flex: 1; overflow-wrap: anywhere; }
.stock-product-card .stock-card-quantity { min-width: 48px; }
.stock-product-card .text-button, .stock-color-detail .text-button { min-height: 44px; }
.stock-alert-badges { display: flex; flex-wrap: wrap; gap: 4px 10px; }
.stock-alert-badges:empty { display: none; }
.stock-alert-badges .status-text { font-size: 12px; }
.stock-color-detail { padding: 16px 0; border-bottom: 1px solid var(--gray-200); }
.stock-color-detail header { display: flex; gap: 10px; align-items: center; margin-bottom: 8px; }
.stock-color-detail header strong { flex: 1; overflow-wrap: anywhere; min-width: 0; }
.stock-color-dot { flex: 0 0 22px; width: 22px; height: 22px; border: 1px solid var(--gray-300); border-radius: 50%; }
.stock-size-detail { display: grid; grid-template-columns: 40px 1fr auto; gap: 8px; align-items: center; min-height: 44px; }
.stock-size-detail small { font-size: 12px; }
.stock-normal { color: var(--gray-500); }
#stockDetailContent { padding: 0 16px; }
#stockDetailModal .modal-actions { margin: 0; padding: 12px 16px 16px; }
